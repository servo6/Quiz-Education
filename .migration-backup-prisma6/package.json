{
  "name": "quiz-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "test": "tsx --test src/import/validate.test.ts src/xp.test.ts src/permissions.test.ts test/auth.test.ts test/subjects.test.ts test/import.test.ts",
    "typecheck": "tsc",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:validate": "prisma validate",
    "db:studio": "prisma studio",
    "test:sql": "python3 scripts/gen-test-sql.py"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/jwt": "^10.2.6",
    "@fastify/rate-limit": "^11.2.1",
    "@prisma/adapter-better-sqlite3": "6.19.3",
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "^6.0.0",
    "fastify": "^5.12.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "better-sqlite3": "^11.10.0",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
