# Chaîne de connexion Supabase : projet > bouton "Connect" > "Session pooler" (compatible IPv4).
# Si le mot de passe contient des caractères spéciaux (@ : / ? # %), les encoder (ex. @ devient %40).
DATABASE_URL="postgresql://postgres.PROJECT_REF:MOT_DE_PASSE@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Optionnel : certificat racine de la base (réglages Supabase > Database > SSL) pour vérifier l'identité du serveur.
# DATABASE_SSL_CA="C:/dev/quiz-platform/prod-ca-2021.crt"

# Optionnel : base utilisée par les tests (par défaut DATABASE_URL). Les tests travaillent dans un schéma
# temporaire "qt_xxxx" supprimé à la fin ; ils ne touchent pas à tes tables.
# TEST_DATABASE_URL="postgresql://..."

# Clé de signature des sessions : 32 caractères minimum, secrète.
JWT_SECRET="remplace-moi-par-une-longue-valeur-secrete-32+"

# Premier administrateur, créé au démarrage s'il n'y en a aucun (retire ADMIN_PASSWORD ensuite).
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-moi-vite"

PORT=3000
HOST="127.0.0.1"
NODE_ENV="development"   # "production" : cookies de session réservés au HTTPS
REGISTRATION_OPEN="true" # "false" : fermer les inscriptions
