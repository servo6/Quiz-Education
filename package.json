{
  "name": "quiz-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "test:unit": "tsx --test src/import/validate.test.ts src/xp.test.ts src/permissions.test.ts test/time.test.ts",
    "test": "tsx --env-file=.env --test src/import/validate.test.ts src/xp.test.ts src/permissions.test.ts src/titles.test.ts src/shuffle.test.ts test/time.test.ts test/auth.test.ts test/subjects.test.ts test/import.test.ts test/solo.test.ts test/duel.engine.test.ts test/duel.async.test.ts test/duelMatrix.test.ts test/progress.test.ts test/admin.test.ts test/library.test.ts test/complete.test.ts test/duel.socket.test.ts test/adminNotPlayer.test.ts test/statsSocial.test.ts",
    "typecheck": "tsc",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:patch": "tsx --env-file=.env scripts/db-patch.ts",
    "db:rls": "tsx --env-file=.env scripts/enable-rls.ts",
    "db:validate": "prisma validate",
    "db:studio": "prisma studio",
    "test:sql": "python scripts/gen-test-sql.py"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/jwt": "^10.2.6",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.8",
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "^6.0.0",
    "cookie": "^2.0.1",
    "fastify": "^5.12.7",
    "pg": "^8.13.0",
    "socket.io": "^4.8.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "prisma": "^6.0.0",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
